# YatraFlow environment variables — copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# Vite inlines VITE_* at BUILD time, so after editing this file you must
# restart the dev server (or redeploy) — a running build never picks up a
# change. `.env.local` is gitignored; this template is committed on purpose.

# ── Required ──────────────────────────────────────────────────────────────
# From supabase.com → your project → Settings → API.
# Both are needed for accounts, trips and every data call. The build warns
# (and, on Vercel, fails) if either is missing, because the app would render
# but every login would fail with a bare "Failed to fetch".
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Server-side (the /i/<id> preview function) ────────────────────────────
# Read at RUNTIME by api/i.js, which returns a shared itinerary's Open Graph
# tags so the link previews as a card. These are NOT the VITE_ pair above:
# Vite inlines VITE_* at build time and those never reach a serverless
# function, so the function needs its own copies under names without the
# prefix. Same two values, same Supabase project. Optional locally — the
# function only runs on Vercel, and it degrades rather than breaks without
# them (an unconfigured deployment answers 503, so no card is claimed).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. The canonical https origin written into og:url. Unset, the
# function uses Vercel's production domain, then the production URL hardcoded
# in api/i.js. Change it in both places if the domain ever moves.
PUBLIC_ORIGIN=

# ── Optional ──────────────────────────────────────────────────────────────
# Leave these blank (or delete the line) and the app still works: maps,
# weather, routing and place search all run on free keyless providers.

# Mappls place autocomplete — free India dev tier at about.mappls.com/api.
# Unset: falls back to Open-Meteo + Wikipedia geosearch.
VITE_MAPPLS_KEY=

# Google Maps Platform (Places + Routes). Needs billing enabled; a client-side
# quota guard caps each SKU at 80% of the free allowance. With a key set,
# suggestions become Google-only with no free-stack fallback.
VITE_GOOGLE_MAPS_API_KEY=

# AI companion drawer — set to `on` to mount it (the deterministic
# trip-grounded answers). Unset/blank leaves it unmounted.
VITE_AI_COMPANION=

# ============ M7 · Premium — the Razorpay rail (server-side only) ==========
# Read by the api/*.js Vercel functions, NEVER by the client bundle: the key
# secret and the service-role key must not reach frontend code. The web app
# itself needs no Razorpay variable — checkout.js is loaded by lib/unlock.ts
# and the key id reaches it from /api/checkout's response.
# Without these, the unlock flow answers 503 "payments are not configured
# yet" and the public page degrades to the free-preview behavior.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Integration gate (opt-in) -- see README "Testing the crew shape".
# Create two throwaway accounts; the harness signs in and signs them up
# (self-service) if missing. Never use real user credentials here.
TEST_USER1_EMAIL=
TEST_USER1_PASS=
TEST_USER2_EMAIL=
TEST_USER2_PASS=

# Local creator fixture -- see README "Rendering the money surfaces".
# `node scripts/seedCreatorFixture.mjs --apply` creates a creator with two priced
# publications and five backdated sales, so the earnings ledger, the payout runs
# and the publish editor can be looked at instead of only asserted. The defaults
# below work as-is; set them to keep two fixtures apart.
FIXTURE_CREATOR_EMAIL=
FIXTURE_PASSWORD=

# Needed only for the fixture's sales rows (`--apply`) and for `--clean`:
# `entitlements` is SELECT-only for authenticated clients by design, so the
# fixture elevates through one of these. Without either it prints the SQL to
# paste instead of half-seeding a creator with no sales. NEVER commit a
# service-role key, and never point either of these at a project you care about.
SUPABASE_SERVICE_ROLE_KEY=
PGCONN=
