# Machine-compared files check out with LF endings on every platform.
# tests/lint-ratchet.test.ts demands a byte-identical rewrite of the
# baseline; a CRLF checkout breaks that comparison on Windows.
eslint-baseline.json text eol=lf

# The CSS graph fingerprint hashes raw file bytes. A CRLF checkout changes every
# hash and the fingerprint, so a Windows clone cannot reproduce an accepted CSS
# baseline. Pin the stylesheet tree to LF on every platform.
src/styles.css text eol=lf
src/styles/** text eol=lf

# Git runs the pre-push hook under sh. A CRLF checkout breaks its shebang line.
.githooks/* text eol=lf

# Change fragments and release receipts are hashed. A CRLF checkout would change the hash.
changelog.d/** text eol=lf
