node_modules/
dist/
.env
.env.local
.env.*.local
*.local
.DS_Store
Thumbs.db
npm-debug.log*
tsconfig.tsbuildinfo

.vercel
.env*
# ...but the committed template is the one exception — see the `!.` line below.
# Without it the `.env*` glob swallows .env.example, and both the README's
# `cp .env.example .env.local` and the runtime hint in src/lib/supabase.ts
# would point at a file that can never exist.
!.env.example
supabase/.temp/
dev_server_run.log
dev_server_err.log
dev.log
docs/diagrams/*.html

# local build/verify output dumps
tsc_out.txt
vitest_out.txt

# local APK downloads from CI artifacts
*.apk
android/app/yatraflow-debug.p12

# local dev-server / push logs (vite writes these when its output is redirected;
# same class of local noise as dev.log / dev_server_run.log above)
dev-server*.log
push.log

# local agent/tool state — design reports, critiques, sandbox state. Never part
# of the app, and never to be swept into a commit by `git add -A`.
.commandcode/
.impeccable/
.freebuff/
