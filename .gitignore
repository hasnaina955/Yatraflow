node_modules/
dist/
.env
.env.local
.env.*.local
*.local
.DS_Store
Thumbs.db
npm-debug.log*
tsconfig.tsbuildinfo

.vercel
.env*
# ...but the committed template is the one exception — see the `!.` line below.
# Without it the `.env*` glob swallows .env.example, and both the README's
# `cp .env.example .env.local` and the runtime hint in src/lib/supabase.ts
# would point at a file that can never exist.
!.env.example
supabase/.temp/
dev_server_run.log
dev_server_err.log
dev.log
docs/diagrams/*.html

# local build/verify output dumps
tsc_out.txt
vitest_out.txt

# local APK downloads from CI artifacts
*.apk
android/app/yatraflow-debug.p12

# local agent skills (project-local installs). `.claude/` itself stays
# un-ignored so committed editor config remains possible.
.agents/
.claude/skills/
skills-lock.json

# Agent-tool working directories and generated briefs — same class as
# `.freebuff/`: regenerateable output, never repo content. `.impeccable/browser/`
# alone is a full browser profile (12 MB), and `PRODUCT.md` carries the skill's
# own schema marker rather than being a hand-written product doc.
.impeccable/
.commandcode/
PRODUCT.md
